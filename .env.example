# PostHog browser analytics. This is a public project token, never a personal
# or secret API key. Configure the same values in the hosting environment.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Automated emails (welcome, weekly family summary, monthly volunteer summary),
# sent through Resend. Nothing sends unless EMAIL_AUTOMATIONS_ENABLED is "true".
# EMAIL_AUTOMATION_SECRET signs unsubscribe links and authorises the scheduled
# runs. EMAIL_TEST_RECIPIENT (comma-separated; "admins" means every approved
# admin) sends a few samples to those inboxes instead, and records nothing.
RESEND_API_KEY=
EMAIL_AUTOMATIONS_ENABLED=false
EMAIL_FROM="Amal School <hello@amalschool.org>"
EMAIL_REPLY_TO=
EMAIL_AUTOMATION_SECRET=
EMAIL_TEST_RECIPIENT=
